# Konoha staging-core environment template.
# Copy to /opt/shared/.agent-env.staging and fill secret values there.

KONOHA_ENV=staging
KONOHA_SERVICE_PROFILE=staging-core

# Staging API/bus endpoint. Do not reuse production 3200 or dashboard 3201.
KONOHA_PORT=3210
KONOHA_URL=http://127.0.0.1:3210
KONOHA_STAGING_URL=http://127.0.0.1:3210
KONOHA_PUBLIC_URL=http://127.0.0.1:3210

# Staging storage. Redis DB 0 and PostgreSQL public schema are production paths.
REDIS_DB=2
STAGING_DATABASE_URL=postgres://127.0.0.1:5432/konoha_staging?options=-c%20search_path%3Dkonoha_staging%2Cpublic
DATABASE_URL=postgres://127.0.0.1:5432/konoha_staging?options=-c%20search_path%3Dkonoha_staging%2Cpublic

# Separate staging state/secrets. Do not point these at production files.
KONOHA_SETUP_FILE=/opt/shared/.konoha-setup.staging.json
KONOHA_DASHBOARD_AUTH_FILE=/opt/shared/.dashboard-auth.staging.json
KONOHA_AGENT_WORKDIR_ROOT=/opt/shared/agent-workdirs-staging
KONOHA_VILLAGE_ID=staging.konoha

# External connectors stay disabled unless a time-boxed waiver is recorded.
KONOHA_ENABLED_CONNECTORS=
KONOHA_HEALTH_ENABLED_CONNECTORS=
KONOHA_ENABLED_OPTIONAL_MONITORS=akamaru
KONOHA_STAGING_ENABLE_EXTERNAL_CONNECTORS=

# Kiba can monitor staging, but remediation needs an explicit operator target.
KIBA_MONITOR_ENVIRONMENT=staging
KIBA_ACTION_TARGET_ENV=

# Required for authenticated API calls in live smoke. Use a staging-only token.
KONOHA_TOKEN=
