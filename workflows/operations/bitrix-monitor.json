{
  "id": "bitrix-monitor",
  "version": "1.0.0",
  "name": "Bitrix Monitor",
  "description": "Periodic monitoring of Bitrix24 pipeline changes: new deals, stage changes, and amount changes. Alerts are routed to the configured sales lead channel.",
  "elements": [
    {
      "id": "e1",
      "type": "event",
      "label": "Scheduled check",
      "trigger": {
        "kind": "timer",
        "cron": "0 9,11,13,15,17,19 * * *"
      }
    },
    {
      "id": "f1",
      "type": "function",
      "label": "Run Bitrix Monitor",
      "role": "automation_service"
    },
    {
      "id": "e2",
      "type": "event",
      "label": "Monitor complete"
    }
  ],
  "flow": [
    ["e1", "f1"],
    ["f1", "e2"]
  ]
}
