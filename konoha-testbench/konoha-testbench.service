[Unit]
Description=Konoha TestBench — Persistent Chromium service for agent-driven GUI testing
After=network.target konoha.service
Requires=konoha.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/konoha/konoha-testbench
EnvironmentFile=-/home/ubuntu/.agent-env
Environment=TESTBENCH_PORT=3203
Environment=TESTBENCH_POOL_SIZE=3
Environment=TESTBENCH_MAX_POOL_SIZE=3
Environment=TESTBENCH_ACQUIRE_TIMEOUT_MS=30000
Environment=DISPLAY=:99
ExecStart=/home/ubuntu/.bun/bin/bun src/server.ts
Restart=on-failure
Slice=konoha-qa.slice
MemoryHigh=900M
MemoryMax=1200M
CPUWeight=100
CPUQuota=150%
TasksMax=2048
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=konoha-testbench

# Chromium needs these for sandbox
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
