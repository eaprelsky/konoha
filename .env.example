# Konoha Bus Configuration
# Copy to .env and fill in values. Never commit .env with real credentials.

# ── Authentication ──────────────────────────────────────────────────────────
KONOHA_TOKEN=              # Admin API token (required for production)
KONOHA_URL=http://127.0.0.1:3200

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Option 1: Full connection string
DATABASE_URL=postgres://user:password@127.0.0.1:5432/konoha
# Option 2: Individual parts (used if DATABASE_URL is not set)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=konoha
PGUSER=
PGPASSWORD=
# Enable PG as read source (shadow writes always active)
PG_READ=false

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_DB=0

# ── LLM Provider ───────────────────────────────────────────────────────────
KONOHA_LLM_PROVIDER=anthropic   # "anthropic" or "glm"
ANTHROPIC_API_KEY=
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Adapters ────────────────────────────────────────────────────────────────
BITRIX24_WEBHOOK_URL=
YONOTE_BASE_URL=https://comindspace.yonote.ru
YONOTE_API_KEY=
TRACKER_TOKEN=
TRACKER_CLOUD_ORG_ID=
CHATBOT_SMTP_HOST=mail.eaprelsky.ru
CHATBOT_SMTP_PORT=587
CHATBOT_SMTP_USER=
CHATBOT_SMTP_PASSWORD=
REPLICATE_API_TOKEN=

# ── GitHub ──────────────────────────────────────────────────────────────────
GH_TOKEN=

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── E2E Tests ───────────────────────────────────────────────────────────────
E2E_USERNAME=eaprelsky
E2E_PASSWORD=
