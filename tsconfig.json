{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": ["src/**/*.ts", "core/**/*.ts", "modules/**/*.ts", "packages/**/*.ts"],
  "exclude": ["node_modules", "dist", "modules/workflow-engine/frontend/**"]
}
