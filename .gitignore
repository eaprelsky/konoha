node_modules/
*.env
dist/

# Agent MCP configs — contain tokens, not for public repos
# Template is safe to commit, actual configs are not
agents/**/.mcp-*.json
!agents/.mcp-template.json
# Agent private config
.owner-config
.shared-credentials
scripts/__pycache__/
agents/**/__pycache__/
tests/__pycache__/
# Playwright auth state — session cookies, never commit
playwright/.auth/user.json
# Playwright test artifacts
test-results/
frontend/test-results/
playwright-report/
