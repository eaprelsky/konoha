      ],
      "required_for": [
        "normal production release",
        "PG_READ/storage/runtime release"
      ],
      "blocks_release_when": "onlyInRedis > 0"
    },
    {
      "id": "healthcheck",
      "class": "blocker",
      "source": "docs/release-policy.md",
      "commands": [
        "KONOHA_SERVICE_PROFILE=prod-core python3 scripts/healthcheck-system.py"
