        "storage or Action Spine change"
      ],
      "blocks_release_when": "portable preflight fails or M1 isolation detects production Redis DB0/PostgreSQL public/connector contamination"
    },
    {
      "id": "golden-path",
      "class": "blocker",
      "source": "docs/golden-path-acceptance-closure-report.json",
