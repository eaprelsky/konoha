      "required_for": [
        "broad Workflow Engine release",
        "deploy/runtime/connector behavior change"
      ],
      "blocks_release_when": "staging-core violates isolation or waiver enables production connectors/weakens prod-core"
    },
    {
      "id": "production-smoke",
      "class": "blocker",
      "source": "docs/release-policy.md",
      "commands": [
        "scripts/preflight.sh"
      ],
      "required_for": [
        "normal production release",
        "post-deploy verification"
      ],
      "blocks_release_when": "production preflight or required live service check fails"
    },
