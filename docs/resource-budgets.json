          "id": "fwupd_background_refresh",
          "classification": "optional_non_konoha",
          "units": ["fwupd.service", "fwupd-refresh.timer"],
          "precondition": "firmware updates are handled manually during maintenance windows",
          "disable_commands": ["systemctl stop fwupd.service", "systemctl disable --now fwupd-refresh.timer"],
          "rollback_commands": ["systemctl enable --now fwupd-refresh.timer", "systemctl start fwupd.service"],
          "expected_savings_mib": 35
        }
      ],
      "unknown_keep_enabled_until_review": [
