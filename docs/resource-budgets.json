        { "id": "ssh", "units": ["ssh.service", "ssh.socket"], "reason": "operator access" },
        { "id": "redis", "units": ["redis-server.service", "redis-server@.service", "redis.service"], "reason": "Konoha bus/data dependency" },
        { "id": "postgresql", "units": ["postgresql.service", "postgresql@.service", "postgresql@16-main.service"], "reason": "Konoha persistence dependency" },
        { "id": "nginx", "units": ["nginx.service"], "reason": "host ingress and reverse proxy" }
      ],
      "disable_candidates": [
        {
          "id": "modem_manager",
          "classification": "optional_non_konoha",
          "units": ["ModemManager.service"],
          "precondition": "host has no cellular modem or WWAN management requirement",
          "disable_commands": ["systemctl disable --now ModemManager.service"],
          "rollback_commands": ["systemctl enable --now ModemManager.service"],
          "expected_savings_mib": 20
        },
        {
          "id": "snap_cups_printing",
          "classification": "optional_non_konoha",
          "units": ["snap.cups.cups-browsed.service", "snap.cups.cupsd.service"],
          "precondition": "host is not used for local printing or printer discovery",
          "disable_commands": ["systemctl disable --now snap.cups.cups-browsed.service", "systemctl disable --now snap.cups.cupsd.service"],
          "rollback_commands": ["systemctl enable --now snap.cups.cupsd.service", "systemctl enable --now snap.cups.cups-browsed.service"],
          "expected_savings_mib": 70
