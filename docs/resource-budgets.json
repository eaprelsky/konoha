    "host_service_audit": {
      "updated_for_issue": 779,
      "source": "systemctl list-unit-files --type=service --type=socket --type=timer; systemctl list-units --state=active",
      "scope_guard": "never_disable_production_konoha_telegram_mail_ssh_redis_postgresql_nginx",
      "protected_services": [
        { "id": "production_konoha", "units": ["konoha.service", "konoha-dashboard.service", "konoha-testbench.service", "konoha-agent-log-retention.service", "konoha-agent-log-retention.timer"], "reason": "production Konoha/API/dashboard/test support" },
        { "id": "telegram", "units": ["telegram-bot.service", "telegram-bus.service", "telegram-context-packer.service", "telegram-event-bridge.service", "telegram-vision-packer.service", "agent-telegram.service"], "reason": "Telegram ingestion and routing" },
