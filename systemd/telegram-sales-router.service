[Unit]
Description=Telegram Sales Router - starts sales workflow cases from lead signals
After=network.target redis-server.service konoha.service telegram-bus.service
Wants=redis-server.service konoha.service telegram-bus.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/konoha
EnvironmentFile=/opt/shared/.shared-credentials
EnvironmentFile=/home/ubuntu/.agent-env
UnsetEnvironment=http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
Environment=PYTHONUNBUFFERED=1
Environment=TELEGRAM_SALES_STREAM=telegram:log
Environment=TELEGRAM_SALES_GROUP=sales-router
Environment=TELEGRAM_SALES_WORKFLOW_ID=lead-qualification
Environment=TELEGRAM_SALES_CHAT_IDS=-4982206077
ExecStart=/usr/bin/python3 -u /home/ubuntu/konoha/scripts/telegram_sales_router.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
