[Unit]
Description=Claude Agent Inojin (Nocturna Marketing) — on-demand
After=network.target redis.service
Wants=agent-watchdog-inojin.service
After=agent-watchdog-inojin.service

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/scripts/agent-inojin-service.sh
ExecStop=/usr/bin/tmux kill-session -t inojin
Restart=on-failure
MemoryMax=800M
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
