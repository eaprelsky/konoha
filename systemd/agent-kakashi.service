[Unit]
Description=Claude Agent Kakashi (Bug Fixer)
After=network.target redis.service
Wants=agent-watchdog-kakashi.service
After=agent-watchdog-kakashi.service

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/konoha/scripts/agent-api-service.sh kakashi
Restart=always
MemoryMax=800M
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
