[Unit]
Description=Akamaru — Konoha System Health Monitor
After=network.target redis.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/.agent-env
Environment=KIBA_MONITOR_ENVIRONMENT=prod
Environment=KIBA_ACTION_TARGET_ENV=prod
ExecStart=/usr/bin/python3 /home/ubuntu/konoha/scripts/akamaru.py
Restart=always
Slice=konoha-agents.slice
MemoryHigh=256M
MemoryMax=384M
CPUWeight=100
CPUQuota=50%
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
