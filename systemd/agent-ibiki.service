[Unit]
Description=Claude Agent Ibiki (Security Pentester) — on-demand
After=network.target redis.service
Wants=agent-watchdog-ibiki.service
After=agent-watchdog-ibiki.service

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/konoha/scripts/agent-ibiki-service.sh
ExecStop=/usr/bin/tmux kill-session -t ibiki
Restart=on-failure
MemoryMax=800M
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
