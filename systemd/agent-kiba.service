[Unit]
Description=Claude Agent Kiba (System Guardian)
After=network.target redis.service
Wants=agent-watchdog-kiba.service
After=agent-watchdog-kiba.service

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/konoha/scripts/agent-kiba-service.sh
Restart=always
MemoryMax=800M
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
