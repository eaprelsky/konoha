[Unit]
Description=Konoha Managed Agent Kiba
After=network.target redis.service konoha.service
Wants=konoha.service agent-watchdog-kiba.service
After=agent-watchdog-kiba.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/.agent-env
Environment=HOME=/home/ubuntu
Environment=KONOHA_AGENT_ID=kiba
Environment=PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.npm-global/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/konoha/scripts/agent-api-service.sh kiba
Restart=always
MemoryMax=800M
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
