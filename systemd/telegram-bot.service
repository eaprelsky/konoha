[Unit]
Description=Telegram Bot Service (Grammy, eaprelsky_agent_bot)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/telegram-bot-service
ExecStart=/home/ubuntu/konoha/scripts/telegram-bot-service.sh
Restart=always
Slice=konoha-connectors.slice
MemoryHigh=384M
MemoryMax=512M
CPUWeight=150
CPUQuota=100%
RestartSec=10

[Install]
WantedBy=multi-user.target
