[Unit]
Description=Konoha Generic Lifecycle Watchdog
After=network.target redis-server.service konoha.service
Wants=redis-server.service konoha.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/.agent-env
Environment=PYTHONUNBUFFERED=1
# Optional workers only. Shikadai has a dedicated reviewer watchdog; Jiraiya is disabled until explicit product need.
Environment=WATCHDOG_AGENTS=mirai,shino,hinata,ibiki,ino,inojin,guy
ExecStart=/usr/bin/python3 /home/ubuntu/konoha/scripts/watchdog-lifecycle.py
Restart=always
Slice=konoha-qa.slice
MemoryHigh=256M
MemoryMax=384M
CPUWeight=100
CPUQuota=50%
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
