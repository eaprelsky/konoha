[Unit]
Description=Claude Watchdog Kiba (Konoha SSE → tmux)
After=network.target redis.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/.agent-env
Environment=PYTHONUNBUFFERED=1
Environment=KIBA_MONITOR_ENVIRONMENT=prod
Environment=KIBA_ACTION_TARGET_ENV=prod
ExecStart=/usr/bin/python3 /home/ubuntu/konoha/scripts/watchdog-kiba.py
Restart=always
Slice=konoha-agents.slice
MemoryHigh=256M
MemoryMax=384M
CPUWeight=100
CPUQuota=50%
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
