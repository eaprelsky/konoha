[Unit]
Description=Claude Agent Ino (Nocturna Marketing) — on-demand
After=network.target redis.service
Wants=agent-watchdog-ino.service
After=agent-watchdog-ino.service

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/konoha/scripts/agent-ino-service.sh
ExecStop=/usr/bin/tmux kill-session -t ino
Restart=on-failure
MemoryMax=800M
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
