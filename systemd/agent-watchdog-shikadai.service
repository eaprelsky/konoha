[Unit]
Description=Konoha GitHub Reviewer Delegation Watchdog Shikadai
After=network.target redis.service konoha.service
Wants=konoha.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/.agent-env
Environment=PYTHONUNBUFFERED=1
# #793/#794: reviewer watchdog dispatches only ready-for-review issues for Shikadai.
# Architecture decomposition is a separate route:architecture-decomposition path.
ExecStart=/usr/bin/python3 /home/ubuntu/konoha/scripts/watchdog-shikadai.py
Restart=always
Slice=konoha-qa.slice
MemoryHigh=256M
MemoryMax=384M
CPUWeight=100
CPUQuota=50%
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
