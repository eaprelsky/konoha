[Unit]
Description=QA Watcher — legacy explicit QA adapter → pings Shino
After=network.target konoha.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/.agent-env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/konoha/scripts/qa-watcher.py
Restart=on-failure
Slice=konoha-qa.slice
MemoryHigh=256M
MemoryMax=384M
CPUWeight=100
CPUQuota=50%
RestartSec=15
StandardOutput=journal
StandardError=journal
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.npm-global/bin:/home/ubuntu/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:/home/ubuntu/.local/bin

[Install]
WantedBy=multi-user.target
