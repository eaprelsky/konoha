[Unit]
Description=Watchdog for Naruto (Claude Agent #1) — Telegram queue + Konoha SSE → tmux
After=network.target konoha.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/.agent-env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/konoha/scripts/watchdog-naruto.py
Restart=on-failure
Slice=konoha-connectors.slice
MemoryHigh=256M
MemoryMax=384M
CPUWeight=150
CPUQuota=75%
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:/home/ubuntu/.local/bin

[Install]
WantedBy=multi-user.target
