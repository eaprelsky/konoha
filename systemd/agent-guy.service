[Unit]
Description=Claude Agent Guy (Developer #10)
After=network.target redis.service
Wants=agent-watchdog-guy.service
After=agent-watchdog-guy.service

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/konoha/scripts/agent-guy-service.sh
ExecStop=/usr/bin/tmux kill-session -t guy
Restart=on-failure
MemoryMax=800M
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
