[Unit]
Description=Konoha Managed Agent Autostart
After=network.target konoha.service telegram-bot.service telegram-bus.service
Wants=konoha.service telegram-bot.service telegram-bus.service

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/home/ubuntu/.agent-env
ExecStart=/usr/bin/python3 /home/ubuntu/konoha/scripts/agent-autostart.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
