{
  "agent_id": "kakashi",
  "tmux_session": "kakashi",
  "debounce_window": 3.0,
  "idle_timeout": 1800,
  "sources": ["konoha-sse", "github-issues"],
  "github": {
    "repo": "eaprelsky/konoha",
    "scan_interval": 900,
    "labels": ["agent:kakashi"],
    "required_states": ["state:ready-for-dev", "state:in-progress"],
    "skip_labels": ["state:done", "state:blocked"]
  },
  "message_prefix": "Задание для Какаши:",
  "message_suffix": "Выполни задание согласно AGENTS.md. Результат сообщи в Коноха."
}
