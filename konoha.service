[Unit]
Description=Konoha Agent Bus
After=network.target redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/konoha
EnvironmentFile=/home/ubuntu/.agent-env
ExecStart=/home/ubuntu/.bun/bin/bun run core/src/server.ts
Restart=always
RestartSec=5
Slice=konoha-core.slice
MemoryHigh=900M
MemoryMax=1200M
CPUWeight=300
CPUQuota=200%
TasksMax=4096
OOMScoreAdjust=-1000

[Install]
WantedBy=multi-user.target
